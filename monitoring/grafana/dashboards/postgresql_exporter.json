        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(pg_stat_database_numbackends{job=\"postgres\",datname!=\"\"})",
          "legendFormat": "backends",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active backends (sum)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(pg_stat_database_xact_commit{job=\"postgres\",datname!=\"\"}[5m]))",
          "legendFormat": "commits/s",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(pg_stat_database_xact_rollback{job=\"postgres\",datname!=\"\"}[5m]))",
          "legendFormat": "rollbacks/s",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Transaction rate (commits & rollbacks / sec)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
